{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:datahandles:spec:0.3:results.schema.json",
  "title": "OperationResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation_id",
    "status",
    "metadata"
  ],
  "properties": {
    "operation_id": {
      "type": "string",
      "pattern": "^op_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "status": {
      "enum": [
        "completed",
        "running",
        "waiting",
        "failed",
        "cancelled"
      ],
      "description": "completed and failed are final. running: the operation is a job, and `handles` holds the job handle. waiting: a graph node that changes the world waits for an approval. cancelled is reserved."
    },
    "output": {},
    "handles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/HandleSummary"
      },
      "description": "The handles that the operation derived. For the status running: the one job handle."
    },
    "error": {
      "$ref": "urn:datahandles:spec:0.3:errors.schema.json"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "execution_time_ms": {
          "type": "number"
        },
        "bytes_transferred": {
          "type": "integer",
          "description": "Size of the serialized output that goes to the caller."
        },
        "source_version": {
          "type": "string",
          "description": "The resource version that the operation observed."
        },
        "reused": {
          "type": "boolean",
          "description": "A graph run gave the stored result of an equal node and did not run the operation again."
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        }
      },
      "then": {
        "required": [
          "error"
        ]
      }
    }
  ],
  "$defs": {
    "HandleSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "type",
        "version",
        "descriptor",
        "capabilities",
        "consistency",
        "lifecycle"
      ],
      "description": "A Handle in which each capability is given by its name only. handle.describe returns the full Handle.",
      "properties": {
        "id": {
          "$ref": "urn:datahandles:spec:0.3:handles.schema.json#/properties/id"
        },
        "kind": {
          "$ref": "urn:datahandles:spec:0.3:handles.schema.json#/properties/kind"
        },
        "type": {
          "$ref": "urn:datahandles:spec:0.3:handles.schema.json#/properties/type"
        },
        "version": {
          "$ref": "urn:datahandles:spec:0.3:handles.schema.json#/properties/version"
        },
        "descriptor": {
          "$ref": "urn:datahandles:spec:0.3:handles.schema.json#/properties/descriptor"
        },
        "consistency": {
          "$ref": "urn:datahandles:spec:0.3:handles.schema.json#/properties/consistency"
        },
        "parents": {
          "$ref": "urn:datahandles:spec:0.3:handles.schema.json#/properties/parents"
        },
        "lifecycle": {
          "$ref": "urn:datahandles:spec:0.3:handles.schema.json#/properties/lifecycle"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
